# Point the browser client at the FastAPI service.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public canonical origin used for sitemap, canonical URLs, and social metadata.
# Set this to the production domain in the hosting provider.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend settings
IRSA_SIA_URL=https://irsa.ipac.caltech.edu/SIA
IRSA_TIMEOUT_SECONDS=30
IRSA_MAX_RECORDS=100
CORS_ORIGINS=http://localhost:3000
PREVIEW_MAX_BYTES=35000000
RATE_LIMIT_PER_MINUTE=40
